profiles:
  coding-fast:
    provider: openai
    model: "gpt-4o-mini"
    description: "Quick edits, boilerplate, simple features"

  reasoning-deep:
    provider: anthropic
    model: "claude-sonnet-4-20250514"
    description: "Architecture decisions, complex refactoring, planning"

  architecture:
    provider: anthropic
    model: "claude-opus-4-20250514"
    description: "System design, tech selection, architectural review"

  review-thorough:
    provider: anthropic
    model: "claude-sonnet-4-20250514"
    description: "PR review, security audit, performance analysis"

  local-only:
    provider: ollama
    model: "qwen2.5-coder:32b"
    description: "Private code, offline work, zero cost"

  test-generation:
    provider: openai
    model: "gpt-4o-mini"
    description: "Unit tests, integration tests, edge cases"

  debugging:
    provider: anthropic
    model: "claude-sonnet-4-20250514"
    description: "Root cause analysis, stack trace interpretation"

agent_config:
  max_turns: 50
  confirm_actions: true
  show_thinking: false

output:
  format: "markdown"
  streaming: true
  show_token_usage: false