# Kiro-CLI Global Configuration
# Renders to ~/.kiro/config.yaml

model_presets:
  coding-fast:
    provider: openai
    model: ${CODING_MODEL:-gpt-4o-mini}
    temperature: 0.1
    max_tokens: 4096

  reasoning-deep:
    provider: anthropic
    model: ${REASONING_MODEL:-claude-sonnet-4-20250514}
    temperature: 0.0
    max_tokens: 8192

  architecture:
    provider: anthropic
    model: ${ARCH_MODEL:-claude-opus-4-20250514}
    temperature: 0.0
    max_tokens: 8192

  review-thorough:
    provider: anthropic
    model: ${REVIEW_MODEL:-claude-sonnet-4-20250514}
    temperature: 0.0
    max_tokens: 8192

  local-only:
    provider: ollama
    model: ${LOCAL_MODEL:-qwen2.5-coder:32b}
    base_url: ${OLLAMA_BASE_URL:-http://localhost:11434}
    temperature: 0.1
    max_tokens: 4096

default_preset: coding-fast

providers:
  anthropic:
    api_key: ${ANTHROPIC_API_KEY}
    base_url: https://api.anthropic.com
  openai:
    api_key: ${OPENAI_API_KEY}
    base_url: https://api.openai.com/v1
  openrouter:
    api_key: ${OPENROUTER_API_KEY}
    base_url: https://openrouter.ai/api/v1
  google:
    api_key: ${GOOGLE_API_KEY}
    base_url: https://generativelanguage.googleapis.com
  ollama:
    base_url: ${OLLAMA_BASE_URL:-http://localhost:11434}

agents:
  enabled: true
  directory: .kiro/agents

skills:
  enabled: true
  directory: .kiro/skills

hooks:
  enabled: true
  directory: .kiro/hooks

keybindings:
  leader: "ctrl+space"
  quick_model_switch: "ctrl+m"

output:
  format: markdown
  streaming: true
  show_tokens: false