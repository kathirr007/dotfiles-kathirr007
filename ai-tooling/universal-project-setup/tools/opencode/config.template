{
  "$schema": "https://opencode.ai/config.json",
  "model_profiles": {
    "coding-fast": {
      "provider": "openai",
      "model": "${CODING_MODEL:-gpt-4o-mini}"
    },
    "reasoning-deep": {
      "provider": "anthropic",
      "model": "${REASONING_MODEL:-claude-sonnet-4-20250514}"
    },
    "architecture": {
      "provider": "anthropic",
      "model": "${ARCH_MODEL:-claude-opus-4-20250514}"
    },
    "review-thorough": {
      "provider": "anthropic",
      "model": "${REVIEW_MODEL:-claude-sonnet-4-20250514}"
    },
    "local-only": {
      "provider": "ollama",
      "model": "${LOCAL_MODEL:-qwen2.5-coder:32b}",
      "base_url": "${OLLAMA_BASE_URL:-http://localhost:11434}"
    }
  },
  "default_model_profile": "coding-fast",
  "providers": {
    "anthropic": {
      "api_key": "${ANTHROPIC_API_KEY}",
      "base_url": "https://api.anthropic.com"
    },
    "openai": {
      "api_key": "${OPENAI_API_KEY}",
      "base_url": "https://api.openai.com/v1"
    },
    "openrouter": {
      "api_key": "${OPENROUTER_API_KEY}",
      "base_url": "https://openrouter.ai/api/v1"
    },
    "google": {
      "api_key": "${GOOGLE_API_KEY}",
      "base_url": "https://generativelanguage.googleapis.com"
    },
    "ollama": {
      "base_url": "${OLLAMA_BASE_URL:-http://localhost:11434}"
    }
  },
  "skills": {
    "enabled": true,
    "directory": ".opencode/skill"
  },
  "agents": {
    "enabled": true,
    "directory": ".opencode/agent"
  },
  "hooks": {
    "enabled": true,
    "directory": ".opencode/hooks"
  },
  "keybinds": {
    "leader": "ctrl+space"
  },
  "formatter": {
    "enabled": true,
    "command": "prettier --write"
  },
  "lsp": {
    "enabled": true
  }
}